{
  "name": "plancia-web",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:stream && npm run test:profile-groups && npm run test:receipts && npm run test:host-actions && npm run test:omniroute && npm run test:action-item-operation && npm run test:workspace-input && npm run test:device-image && npm run test:format && npm run test:overview && npm run test:history && npm run test:obsidian && npm run test:agents-remoting && npm run test:pwa && npm run test:agents-shell && npm run test:release",
    "test:release": "node --test tests/release-preflight.test.mjs",
    "test:pwa": "node --test tests/pwa.test.mjs",
    "test:agents-shell": "node --test tests/agents-shell.test.mjs tests/guacamole-session.test.mjs",
    "test:history": "node --experimental-strip-types tests/history-ranges.test.ts && node --test tests/fleet-ui.test.mjs",
    "test:device-image": "node --no-warnings --test tests/device-image.test.mjs",
    "test:overview": "node --experimental-strip-types tests/overview-state.test.ts",
    "test:stream": "node --experimental-strip-types --test tests/stream-auth.test.ts",
    "test:receipts": "node --no-warnings --test tests/receipt-evidence.test.mjs",
    "test:host-actions": "node --experimental-strip-types --test tests/host-action-feedback.test.ts",
    "test:omniroute": "node --experimental-strip-types --test tests/omniroute-refresh.test.ts",
    "test:action-item-operation": "tsc --noEmit --strict --target ES2022 --lib ES2022,DOM,DOM.Iterable --module ESNext --moduleResolution bundler --skipLibCheck --isolatedModules --verbatimModuleSyntax tests/action-item-operation.test.ts",
    "test:workspace-input": "node --test tests/workspace-input.test.mjs && node --experimental-strip-types --test tests/notion-dates.test.ts",
    "test:profile-groups": "node --experimental-strip-types tests/profile-groups.test.ts && node --experimental-strip-types --test tests/profile-refresh.test.ts",
    "test:format": "node --experimental-strip-types tests/format.test.ts",
    "test:obsidian": "node --experimental-strip-types --test tests/obsidian-model.test.ts && node --test tests/obsidian-render.test.mjs",
    "test:agents-remoting": "node --experimental-strip-types --test tests/agents-remoting-contract.test.ts"
  },
  "dependencies": {
    "@pelotech/guacamole-common-js": "1.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-wiki-link": "2.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
