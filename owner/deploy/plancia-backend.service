[Unit]
Description=Plancia owner web backend
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/plancia/current/owner
EnvironmentFile=%h/.config/controlcenter/secrets/fleet-dashboard-auth.env
ExecStart=%h/.local/share/plancia/current/owner/.venv/bin/python -m uvicorn backend.server:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/controlcenter/dashboard-state
MemoryMax=512M
TasksMax=128
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CONTROLCENTER_OBSIDIAN_EDITING=1
Environment=CONTROLCENTER_DASHBOARD_STATE_DIR=%h/.local/state/controlcenter/dashboard-state
Environment=CONTROLCENTER_TRUSTED_PROXY_IPS=100.64.0.0/10,fd7a:115c:a1e0::/48
Environment=FLEETPROBE_TOKEN_FILE=%h/.config/controlcenter/secrets/fleetprobe-token
Environment=PLANCIA_FLEET_CONFIG=%h/.config/plancia/fleet.json
Environment=PLANCIA_PROFILE_COMMANDS_FILE=%h/.config/plancia/profile-commands.json
Environment=PLANCIA_REQUIRE_PRIVATE_CONFIG=1

[Install]
WantedBy=default.target
